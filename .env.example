# All optional. Set these in Railway → your service → Variables.

# Slotana API base URL (check slotana.io/api-reference if games fail to create)
SLOTANA_API_URL=https://api.slotana.io
CLUSTER=mainnet
# A private RPC (Helius etc.) is more reliable than the public one
RPC_URL=https://api.mainnet-beta.solana.com

BET_SOL=0.005
ROUNDS_PER_CYCLE=5
CYCLE_HOURS=12
COOLDOWN_SEC=20

# Leave empty for no password. Set it to lock Start/Stop and key export.
ADMIN_PASSWORD=

# true = simulate everything, no real SOL moves
DRY_RUN=false

# Restore existing wallets instead of generating new ones (base58 private keys)
WALLET_A_KEY=
WALLET_B_KEY=
